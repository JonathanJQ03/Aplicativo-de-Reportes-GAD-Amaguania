rules_version = '2';

// Reglas de Firestore de VeciApp.
//
// TODO(S07): ampliar las reglas por rol (administrador del GAD, reportes,
// residencias y auditoría). Por ahora solo se permite que cada vecino lea y
// cree su propio perfil, separando los datos públicos de los sensibles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }

    match /users_private/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // RF-06: todo perfil nuevo debe registrar la aceptación del aviso de
      // privacidad con la hora del servidor y la versión del texto aceptado.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.consentAcceptedAt is timestamp
        && request.resource.data.consentVersion is string;
      // S05 permite cambiar únicamente el correo privado cuando el dueño ya
      // verificó el nuevo correo en Firebase Auth. El resto de campos queda
      // inmutable desde el cliente.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.email is string;
    }
  }
}
